# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# store submission credentials — NEVER commit (repo is public)
google-service-account.json

# subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/

# local env files — NEVER commit secrets (Supabase keys live in .env; see spec §0.3)
.env
.env.local
.env*.local

# logs
*.log

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI scratch state (records the last-seen CLI version; pure churn)
supabase/.temp/

# App Store screenshots: large binaries, regenerated by scripts/frame-screenshots.py
/store-screenshots

# Old internal plan kept locally only (predates the rename; not for the public repo)
/docs/superpowers/plans/2026-07-27-project-entries-recurring-migration.md
